# Copy to `.env` and fill in. Loaded automatically by the `obc` CLI.

# New York Times Best Sellers — free key from https://developer.nytimes.com
# (create an app, enable the "Books API"). Without it the NYT list provider skips.
NYT_API_KEY=

# Optional: root directory for ALL catalog data (records, html cache, side files,
# checkpoint, and the DB). Defaults to ./data — set to a mounted volume to keep
# everything on persistent storage with one variable.
# OBC_DATA=data

# Optional: point the web UI / tools at a different SQLite catalog file
# specifically. Defaults to $OBC_DATA/catalog.db.
# OBC_DB=data/catalog.db

# Optional: absolute origin for canonical / Open Graph / sitemap URLs. Left empty
# those fall back to the request's own base URL, which is what you want locally —
# set it only to preview the production markup. In production it lives in fly.toml.
# OBC_SITE_URL=https://onlinebibliotheekcatalogus.nl

# Optional: log level for the obc CLI and web app (DEBUG/INFO/WARNING/...).
# OBC_LOG_LEVEL=INFO

# Optional: shared bearer token protecting POST /admin/refresh (the daily cron
# machine sends it). In production: fly secrets set OBC_REFRESH_TOKEN=$(openssl rand -hex 32)
# OBC_REFRESH_TOKEN=

# Optional: refresh the catalog on every (web app) start — full harvest on a fresh
# volume, incremental sync otherwise. Leave unset locally so dev never scrapes.
# OBC_REFRESH_ON_STARTUP=1

# Optional: enrich detail-only fields (Leeftijd, explicit Serie, keywords) from the
# detail pages during the refresh; "0" pauses it.
# OBC_ENRICH=1
